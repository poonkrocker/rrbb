# ============================================================
#  Subdominio / carpeta /carta — .htaccess
# ============================================================
Options -Indexes
RewriteEngine On

# Bloquear acceso a .git si existiera en el servidor
RewriteRule (^|/)\.git(/|$) - [F,L]

# Bloquear archivos internos, diagnósticos y copias viejas
<FilesMatch "(\.(log|sql|bak|env|md|zip)$|^db_connect\.php$|^diag.*\.php$|^test\.php$|\-old\.(php|css|html)$|^index_old\.php$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddDefaultCharset UTF-8
